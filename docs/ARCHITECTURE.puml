@startuml mimic3_architecture
!theme plain
skinparam backgroundColor #FAFAFA
skinparam defaultFontName "Segoe UI"
skinparam ArrowColor #555555
skinparam ComponentBorderColor #333333
skinparam ComponentBackgroundColor #EEF5FF
skinparam DatabaseBorderColor #333333
skinparam DatabaseBackgroundColor #FFF8DC
skinparam NoteBackgroundColor #FFFFCC
skinparam NoteBorderColor #999999

title Mimic3 システムアーキテクチャ

' ═══════════════════════════════════════════════════════════
' 全体コンポーネント図
' ═══════════════════════════════════════════════════════════

package "エントリポイント" {
  component [__main__.py\nmain()] as MAIN #E8F5E9
  component [mcp_server.py\nMCP Server] as MCP #E8F5E9
}

package "設定層" {
  database [".env"] as ENV #FFF8DC
  component [config.py\nload_config()] as CFG #DDEEFF
  component [DualConfig] as DCFG #DDEEFF
  component [OpenRouterConfig] as OCFG #DDEEFF
}

package "オーケストレーション層" {
  component [DualModelOrchestrator] as DMO #FFE4B5
  component [AgentOrchestrator\n(Plan-and-Execute)] as AO #FFE4B5
  component [InteractiveOrchestrator\n(ReAct)] as IO #FFE4B5
  component [WorkflowGraph] as WG #FFE4B5
}

package "AI モデル層" {
  component [MistralThinker\nMistral Large 3\n(ツールなし)] as THINKER #E0E0FF
  component [OpenRouterAgent\nOwlAlpha\n(フルツール)] as ACTOR #E0E0FF
  component [Planner\nJSON mode] as PLANNER #E0E0FF
  component [Reviewer] as REVIEWER #E0E0FF
  component [Reflector] as REFLECTOR #E0E0FF
}

package "ツール層" {
  component [ToolRegistry] as TR #F0F0F0
  component [run_powershell] as PS #F5F5F5
  component [read/write/edit_file] as RF #F5F5F5
  component [web_search\nfetch_webpage] as WEB #F5F5F5
  component [list_directory\nglob/search] as FS #F5F5F5
}

package "インフラ層" {
  component [AutoGit] as AG #FFDDDD
  component [TokenBucket\nレート制限] as TL #FFDDDD
  component [ReactLog] as RL #FFDDDD
}

' 関係
MAIN --> CFG : 設定ロード
MCP --> MAIN : 起動
ENV --> CFG : 読み込み
CFG --> DCFG : Mistral あり
CFG --> OCFG : Mistral なし

MAIN --> DMO : dual モード
MAIN --> AO : plan モード
MAIN --> IO : interactive モード

DMO --> THINKER : 計画・評価
DMO --> IO : 実行委譲
DMO --> AG : バックアップ
IO --> ACTOR : ReAct 実行
AO --> PLANNER : 計画生成
AO --> REVIEWER : 結果検証
AO --> REFLECTOR : 最終検証
AO --> WG : 制御フロー
AO --> ACTOR : ステップ実行

ACTOR --> TR : ツール呼び出し
TR --> PS
TR --> RF
TR --> WEB
TR --> FS

ACTOR --> TL : RPM チェック
ACTOR --> AG : checkpoint
IO --> RL : ログ記録

@enduml

@startuml dual_mode_sequence
!theme plain
skinparam backgroundColor #FAFAFA
skinparam SequenceArrowThickness 2
skinparam ParticipantBorderColor #333333
skinparam ParticipantBackgroundColor #EEF5FF

title DualModelOrchestrator — Thinker/Actor 協調シーケンス

actor ユーザー as U
participant "DualModelOrchestrator" as DMO
participant "MistralThinker" as MT
participant "InteractiveOrchestrator" as IO
participant "OpenRouterActor" as OA
participant "AutoGit" as AG
participant "WorkflowGraph" as WG

== Phase 1: 計画生成 ==

U -> DMO : run(user_message)
DMO -> MT : plan(user_message)
activate MT
MT --> DMO : steps JSON
deactivate MT
DMO -> U : 計画表示 (Step 1..N)
U -> DMO : 承認 [y/N]

== Phase 2: 適応型ワークフロー ==

loop remaining が空になるまで

  DMO -> OA : run_react(step.description)
  activate OA
  OA -> AG : backup(cwd)
  OA --> DMO : step_result
  deactivate OA

  DMO -> WG : parse_state_updates(result)

  alt ステップ失敗
    DMO -> WG : resolve_failure()
    alt retry
      DMO -> OA : 再実行
    else skip
      note right: 次ステップへ
    else abort
      DMO --> U : 中断
    else goto:label
      DMO -> DMO : ジャンプ先へ
    end
  end

  alt ステップ成功
    DMO -> WG : resolve_success()
    opt goto:label
      DMO -> DMO : ジャンプ先へ
    end
  end

  DMO -> MT : step_review(goal, executed, result, remaining)
  activate MT
  MT --> DMO : decision JSON
  deactivate MT

  alt action=continue
    note right: 残りをそのまま続行
  else action=replan
    DMO -> MT : 新計画で remaining 差し替え
    note right: replan_count++
  else action=done
    DMO -> DMO : ループ終了
  end

end

== Phase 3: 最終レビュー ==

DMO -> MT : review(all_summaries)
activate MT
MT --> DMO : レビューコメント
deactivate MT
DMO --> U : 結果表示

@enduml

@startuml workflow_graph_state
!theme plain
skinparam backgroundColor #FAFAFA
skinparam StateBorderColor #333333
skinparam StateBackgroundColor #EEF5FF

title WorkflowGraph — PlanStep 状態遷移

[*] --> pending : ステップ作成

pending --> running : 実行開始

running --> done : 成功
running --> failed : 失敗

failed --> retrying : on_failure=retry
retrying --> running : 再実行
retrying --> skipped : 上限超過

failed --> skipped : on_failure=skip
failed --> [*] : on_failure=abort

done --> [*] : on_success="" (次へ)
done --> [*] : on_success=abort

state "goto:<label>" as GOTO
failed --> GOTO : on_failure=goto
done --> GOTO : on_success=goto
GOTO --> running : ジャンプ先で再開

skipped --> [*]

@enduml

@startuml react_loop
!theme plain
skinparam backgroundColor #FAFAFA
skinparam ActivityBorderColor #333333
skinparam ActivityBackgroundColor #EEF5FF

title InteractiveOrchestrator — ReAct ループ

start

:AutoGit.backup();
:コンテキスト構築;

while (step < 60?) is (yes)
  :ストリーミング API 呼び出し;
  if (ツール呼び出しあり?) is (yes) then
    if (読み取りのみ複数?) is (yes) then
      :並列ツール実行\nThreadPoolExecutor;
    else (no)
      :逐次ツール実行\n+ AutoGit checkpoint;
    endif
    :Observation を messages に追加;
    :step++;
  else (no)
    :最終回答;
    :会話履歴保存;
    stop
  endif
endwhile (no)

:上限到達フォールバック;
stop

@enduml

@startuml class_diagram
!theme plain
skinparam backgroundColor #FAFAFA
skinparam ClassBorderColor #333333
skinparam ClassBackgroundColor #EEF5FF

title Mimic3 クラス関係図

class DualModelOrchestrator {
  +thinker: MistralThinker
  +actor_orch: InteractiveOrchestrator
  +auto_git: AutoGit
  +run(user_message): str
  -_execute_adaptive_workflow(steps, goal): str
  -_execute_workflow_plan(steps): str
  -_wait_cooldown()
}

class MistralThinker {
  +config: MistralConfig
  +conversation: list
  +think(user_message): str
  +plan(user_message): list
  +review(summary): str
  +step_review(...): dict
  -_call_api(messages): str
  -_stream_call_api(messages, cb): str
}

class InteractiveOrchestrator {
  +agent: OpenRouterAgent
  +auto_git: AutoGit
  +react_log: ReactLog
  +run_react(user_message): str
  -_run_react_inner(user_message): str
}

class AgentOrchestrator {
  +planner: OpenRouterAgent
  +executor: OpenRouterAgent
  +reflector: OpenRouterAgent
  +run_with_plan(user_message): str
  -_parse_plan(text): list
  -_reflect_and_correct(...): str
}

class WorkflowGraph {
  +steps: list<PlanStep>
  +state: dict
  +resolve_failure(step): tuple
  +resolve_success(step): tuple
  +parse_state_updates(result)
  +state_set(key, value)
}

class PlanStep {
  +index: int
  +description: str
  +status: str
  +result: str
  +parallel: bool
  +label: str
  +on_failure: str
  +on_success: str
  +max_iterations: int
  +join_policy: str
}

class OpenRouterAgent {
  +rotator: AccountRotator
  +tools: ToolRegistry
  +cwd: str
  +run(prompt): str
  +run_stream(prompt, cb): str
  +set_system_prompt(prompt)
  +clear_history()
  -_stream_react_call(messages): tuple
}

class MistralConfig {
  +api_key: str
  +model: str
  +rpm_limit: int
  +acquire(): float
}

class OpenRouterConfig {
  +api_keys: list
  +model: str
  +rpm_limit: int
  +acquire_key(): tuple
}

class DualConfig {
  +thinker: MistralConfig
  +actor: OpenRouterConfig
  +is_dual: bool
}

DualModelOrchestrator --> MistralThinker : 計画・評価
DualModelOrchestrator --> InteractiveOrchestrator : 実行委譲
DualModelOrchestrator --> WorkflowGraph : 制御フロー
InteractiveOrchestrator --> OpenRouterAgent : ReAct 実行
AgentOrchestrator --> OpenRouterAgent : Plan 実行
AgentOrchestrator --> WorkflowGraph : 制御フロー
MistralThinker --> MistralConfig : API設定
OpenRouterAgent --> OpenRouterConfig : API設定
DualConfig --> MistralConfig : Thinker設定
DualConfig --> OpenRouterConfig : Actor設定
WorkflowGraph --> PlanStep : ステップ管理

@enduml
